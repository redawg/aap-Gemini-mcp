# Copy to repo-root .env (gitignored). Never commit real secrets.

AAP_URL=https://aap.example.com
AAP_USERNAME=admin
AAP_PASSWORD=R3dh2t!2026
AAP_ADMIN_PASSWORD=R3dh2t!2026
AAP_MCP_USER=mcp-service
AAP_MCP_USER_PASSWORD=
AAP_MCP_TOKEN=
MCP_BASE_URL=https://aap.example.com:8448
# OpenShift MCP route example (no :8448):
# MCP_BASE_URL=https://aap-mcp.apps.example.com
# Public LB / reverse-proxy on :443 (recommended for Gemini Agent Platform):
# MCP_BASE_URL=https://mcp.example.com

# Registry (containerized online install)
# registry_username=
# registry_password=

# Blank GCP from-scratch (see docs/DEPLOY-GCP-FROM-SCRATCH.md)
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# GCP_ZONE=us-central1-a
# VM_NAME=aap-server
# VM_IP=
# Optional managed targets (ask user; RHEL 9 + RHEL 10)
# CREATE_TARGET_HOSTS=yes
# RHEL9_TARGET_IP=
# RHEL10_TARGET_IP=
# AAP_FQDN=aap.example.com
# MCP_FQDN=mcp.example.com
# DNS_ZONE=
# GOOGLE_APPLICATION_CREDENTIALS=

# OpenShift when applicable
# OC_SERVER=
# OC_TOKEN=

# Gemini CLI / Vertex
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=true
# GEMINI_CLI_TRUST_WORKSPACE=true

# Gemini Agent Platform (GCP)
# GCP_LOCATION=global
# GEMINI_AGENT_ID=aap-ops-agent

# Browser chat sandbox (sandbox/ → Cloud Run)
# SANDBOX_PASSWORD=
# SESSION_SECRET=
# SANDBOX_URL=
# GEMINI_MODEL=gemini-2.5-flash
# MCP_TOOLSETS=mcp
# ENABLE_GOOGLE_SEARCH=true
# ENABLE_URL_CONTEXT=true
# ENABLE_CODE_EXECUTION=true
