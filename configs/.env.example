# Copy to .env (gitignored) and fill in. Never commit real secrets.

# AAP gateway (UI/API) — not necessarily the MCP host
AAP_URL=https://aap-aap.apps.EXAMPLE.redhatworkshops.io
AAP_USERNAME=admin
AAP_PASSWORD=

# Token from AAP Access Management → Users → Tokens (or gateway /api/gateway/v1/tokens/)
AAP_MCP_TOKEN=

# MCP base from OpenShift *-mcp route Location, or https://host:8448 for containerized
# Example after deploy: https://aap-mcp.apps.EXAMPLE.redhatworkshops.io
MCP_BASE_URL=

# Optional: OpenShift (same cluster as AAP)
# OC_SERVER=https://api.EXAMPLE:6443
# OC_TOKEN=

# Optional: Gemini Agent Platform
# GCP_PROJECT_ID=
# GCP_LOCATION=global

# Optional: AWS keys for AAP "Amazon Web Services" credential (playbooks) — not MCP auth
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
