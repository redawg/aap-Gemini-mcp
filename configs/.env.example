# Copy to repo-root .env (gitignored). Never commit real secrets.

# AAP gateway (UI/API)
AAP_URL=https://aap-aap.apps.cluster-kw8lw-1.dyn.redhatworkshops.io
AAP_USERNAME=admin
AAP_PASSWORD=

# Token from AAP Access Management → Users → Tokens (or POST /api/gateway/v1/tokens/)
AAP_MCP_TOKEN=

# MCP route (OpenShift route aap-mcp) — NOT the gateway host
MCP_BASE_URL=https://aap-mcp-aap.apps.cluster-kw8lw-1.dyn.redhatworkshops.io

# OpenShift (same cluster as AAP)
OC_SERVER=https://api.cluster-kw8lw-1.dyn.redhatworkshops.io:6443
# OC_TOKEN=

# Optional: Gemini Agent Platform
# GCP_PROJECT_ID=
# GCP_LOCATION=global

# Optional: AWS keys for AAP Amazon credential (playbooks) — not MCP auth
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
